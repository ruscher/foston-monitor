BigFoston: gifdec do LVGL 9.2.2
- aceita GIF87a (era recusado com "invalid version")
- o último código LZW pode completar o quadro exatamente (">=" virou ">"),
  senão GIFs válidos falham com "LZW table token overflows the frame buffer"

--- a/src/libs/gif/gifdec.c	2026-11-21 12:10:34.788325729 -0300
+++ b/src/libs/gif/gifdec.c	2026-11-21 12:10:34.789931366 -0300
@@ -89,7 +89,8 @@
     }
     /* Version */
     f_gif_read(gif_base, sigver, 3);
-    if(memcmp(sigver, "89a", 3) != 0) {
+    /* BigFoston: GIF87a também é válido (sem extensões, que o leitor ignora) */
+    if(memcmp(sigver, "89a", 3) != 0 && memcmp(sigver, "87a", 3) != 0) {
         LV_LOG_WARN("invalid version");
         goto fail;
     }
@@ -596,7 +597,8 @@
         if(ret == 1) key_size++;
         entry = table->entries[key];
         str_len = entry.length;
-	if(frm_off + str_len >= frm_size){
+	/* BigFoston: ">" (era ">="): o último código pode completar o quadro exatamente */
+	if(frm_off + str_len > frm_size){
 		LV_LOG_WARN("LZW table token overflows the frame buffer");
 		return -1;
 	}
