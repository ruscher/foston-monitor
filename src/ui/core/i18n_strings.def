X(S_AP_HOME_KIOSK_HINT, "ap.home_kiosk_hint", "A Início mostra só os apps escolhidos e o Terminal sai da barra. Para voltar aqui, segure Ajustes por 2 s.", "Home shows only the chosen apps and Terminal leaves the bar. To come back here, hold Settings for 2 s.", "Inicio muestra solo las apps elegidas y Terminal sale de la barra. Para volver, mantenga Ajustes 2 s.")

/* ---- Big Screen ---- */
X(S_BS_SUB,        "bs.sub", "O FOSTON como painel do Big Screen Monitor do PC", "The FOSTON as the PC's Big Screen Monitor panel", "El FOSTON como panel del Big Screen Monitor del PC")
X(S_BS_WAITING,    "bs.waiting", "Aguardando o PC…", "Waiting for the PC…", "Esperando el PC…")
X(S_BS_CONNECTED,  "bs.connected", "Conectado a %s", "Connected to %s", "Conectado a %s")
X(S_BS_FRAMES,     "bs.frames", "%u quadros recebidos", "%u frames received", "%u cuadros recibidos")
X(S_BS_FAILED,     "bs.failed", "Não foi possível abrir a conexão", "Could not open the connection", "No se pudo abrir la conexión")
X(S_BS_STEPS,      "bs.steps", "1. Ligue o FOSTON ao PC pelo cabo USB (rede USB, 192.168.7.2).\n2. No Big Screen Monitor do PC, ative o display \"FOSTON FS-707DC (BigFoston OS)\".\n3. O painel aparece aqui sozinho, com toque.", "1. Connect the FOSTON to the PC with the USB cable (USB network, 192.168.7.2).\n2. In the PC's Big Screen Monitor, enable the \"FOSTON FS-707DC (BigFoston OS)\" display.\n3. The panel shows up here by itself, with touch.", "1. Conecte el FOSTON al PC con el cable USB (red USB, 192.168.7.2).\n2. En el Big Screen Monitor del PC, active la pantalla \"FOSTON FS-707DC (BigFoston OS)\".\n3. El panel aparece aquí solo, con toque.")
X(S_BS_OSD_ON,     "bs.osd_on", "Big Screen conectado", "Big Screen connected", "Big Screen conectado")
X(S_BS_OSD_EXIT,   "bs.osd_exit", "Para sair, segure o canto superior esquerdo por 3 s", "To leave, hold the top-left corner for 3 s", "Para salir, mantenga la esquina superior izquierda 3 s")
X(S_BS_OSD_OFF,    "bs.osd_off", "Big Screen desconectado", "Big Screen disconnected", "Big Screen desconectado")
X(S_BS_EXIT_HINT,  "bs.exit_hint", "Para sair durante a transmissão, segure o canto superior esquerdo da tela por 3 segundos.", "To leave while streaming, hold the top-left corner of the screen for 3 seconds.", "Para salir durante la transmisión, mantenga la esquina superior izquierda 3 segundos.")

