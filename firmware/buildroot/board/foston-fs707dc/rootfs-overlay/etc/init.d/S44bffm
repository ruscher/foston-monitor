#!/bin/sh
# bffm: transmissor FM (docs/fm-radio). Nunca transmite sozinho: no boot e ao desligar o
# aparelho o transmissor é desligado (o alto-falante volta). Ligar é só pelo app Rádio FM.
case "$1" in
start|stop)
    [ -x /usr/sbin/bffm ] && /usr/sbin/bffm off >/dev/null 2>&1
    ;;
restart)
    ;;
esac
exit 0
