#!/bin/sh
# Sets the clock from the PC's time that bfagent.py boot-mem stamps into the
# device tree (/chosen/bigfoston,boot-epoch = moment of the jump to Linux).
# The agent's autoboot stamps the Windows CE clock (kept by its RTC) instead,
# or nothing when that clock is not set (before 2024). There is no RTC driver
# in Linux yet, so without a valid stamp the clock stays unset (1970) and the
# shell shows "--:--".
P=/proc/device-tree/chosen/bigfoston,boot-epoch
case "$1" in
start)
    [ -f "$P" ] || exit 0
    epoch=$((0x$(hexdump -v -e '1/1 "%02x"' "$P")))
    [ "$epoch" -ge 1704067200 ] || { echo "clock: sem hora válida no boot"; exit 0; }
    up=$(cut -d. -f1 /proc/uptime)
    date -s "@$((epoch + up))" > /dev/null && echo "clock: $(date)"
    ;;
esac
