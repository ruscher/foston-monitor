# BigFoston OS kernel, first bring-up: CPU, RAM, CIRQ, GPT, framebuffer text console, initramfs.
CONFIG_LOCALVERSION="-bigfoston"
CONFIG_SYSVIPC=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_LOG_BUF_SHIFT=16
CONFIG_BLK_DEV_INITRD=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
CONFIG_RD_XZ=y
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_EXPERT=y
CONFIG_KALLSYMS_ALL=y
# CONFIG_ARCH_MULTI_V7 is not set
CONFIG_ARCH_MULTI_V6=y
CONFIG_ARCH_MT3351=y
CONFIG_MT3351_BOOTCON=y
# CONFIG_SMP is not set
CONFIG_AEABI=y
# CONFIG_VFP is not set
CONFIG_ARM_ERRATA_411920=y
# CONFIG_MODULES is not set
# CONFIG_SUSPEND is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# CONFIG_VT is not set
# CONFIG_LEGACY_PTYS is not set
CONFIG_UNIX98_PTYS=y
# CONFIG_HW_RANDOM is not set
# CONFIG_HWMON is not set
# Network over USB (CDC-ECM) + USB serial console (CDC-ACM): g_cdc on the MT3351 MUSB
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
# CONFIG_IPV6 is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_ETHERNET is not set
CONFIG_USB_SUPPORT=y
# CONFIG_USB is not set
CONFIG_USB_GADGET=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_GADGET=y
CONFIG_USB_MUSB_MT3351=y
CONFIG_MUSB_PIO_ONLY=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_CDC_COMPOSITE=y
# CONFIG_NETWORK_FILESYSTEMS is not set
CONFIG_TMPFS=y
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PANIC_TIMEOUT=0
# CONFIG_DEBUG_FS is not set
CONFIG_STACKTRACE=y
CONFIG_DEBUG_USER=y
CONFIG_DEBUG_BUGVERBOSE=y
CONFIG_PSTORE=y
# CONFIG_PSTORE_COMPRESS is not set
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_MEMTEST=y
CONFIG_CRC32=y
# touchscreen (evdev for user space)
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_MT3351=y
# power button (GPIO 106, polled) as KEY_POWER
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_MT3351_PWRKEY=y
# /dev/fb0 on the framebuffer Windows CE leaves running (simple-framebuffer node)
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
# SD card (MSDC1), FAT
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MT3351=y
CONFIG_VFAT_FS=y
# nomes em UTF-8 sem o alerta "utf8 is not a recommended IO charset" (o FAT
# continua sem distinção de maiúsculas para nomes ASCII)
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# backlight level (PMU word 0x80061308)
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_MT3351=y
# restart through the watchdog
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_MT3351=y
# speaker (ALSA)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_ARM=y
CONFIG_SND_MT3351=y
# CONFIG_SND_DRIVERS is not set
# CONFIG_SND_USB is not set
# OSS emulation: /dev/dsp for mpg123, /dev/mixer for the shell's volume
CONFIG_SND_OSSEMUL=y
CONFIG_SND_PCM_OSS=y
CONFIG_SND_MIXER_OSS=y
# UART1..4 (ttyS0 = UART1/GPS, ttyS1 = UART2/Bluetooth, ttyS2, ttyS3)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_SERIAL_8250_MT3351=y
# battery/charger status (read only, in mt3351-ts)
CONFIG_POWER_SUPPLY=y
# XZ kernel and initramfs: ~1.2 MB less to send over the 60 KB/s USB link
CONFIG_KERNEL_XZ=y
# Reiniciar sem desligar: o watchdog deixa o aparelho desligado, então o
# Linux reinicia a si mesmo com kexec (bigfoston-reboot)
CONFIG_KEXEC=y
# memória (docs/performance/05-zram.md): zram para o teste comparativo de
# compressores; não é ativado no boot (com ~85 MB livres não há pressão).
# PSI: pressão de CPU/memória/IO em /proc/pressure para medir
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_PSI=y
# Bluetooth (docs/hardware-enablement/06): MediaTek MT6611 na UART2 (ttyS1), H4.
# O chip é ligado e testado por /usr/sbin/bfbt-attach, que entrega a UART ao kernel.
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
CONFIG_BT_LE=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_UHID=y
# DualShock 4 / DualSense: o hid-playstation configura o controle (relatórios a cada poucos ms,
# luz, vibração, bateria); sem ele o DS4 mandava ~6 relatórios/s (docs/jogos-e-pacotes/07)
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_HID_PLAYSTATION=y
CONFIG_PLAYSTATION_FF=y
