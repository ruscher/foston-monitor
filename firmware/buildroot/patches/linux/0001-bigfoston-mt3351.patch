+	0x7f2f, 0x7f2f, 0x7f2f, 0x7f4f, 0x7f4f, 0x7f4f, 0x7f4f, 0x7f4e, 0x7f4e, 0x7f4e, 0x874e, 0x874e, 0x874e, 0x874e, 0x874e, 0x874e,
